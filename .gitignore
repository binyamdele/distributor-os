node_modules/
.next/
out/
build/
dist/
coverage/

# Secrets — never commit. .env.example is the only env file in version control.
.env
.env.local
.env.*.local

# Local file storage for uploaded payment proofs (contains customer data).
# Anchored to the repository root: an unanchored `storage/` matches any directory of that
# name at any depth, and would silently exclude src/platform/storage — the module that
# writes these files — from every commit.
/storage/
!/storage/.gitkeep

# Test artefacts
test-results/
playwright-report/
blob-report/
.playwright/

# Editor / OS
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# TypeScript incremental build cache
*.tsbuildinfo
