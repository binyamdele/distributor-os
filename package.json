{
  "name": "distributor-os",
  "version": "0.1.0",
  "private": true,
  "description": "AI operating assistant for Ethiopian construction-material distributors",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "tsx prisma/reset.ts",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "seed:volume": "tsx prisma/seed-volume.ts",
    "test:perf": "vitest run --project integration tests/integration/dashboard-performance.test.ts",
    "admin:create-organization": "tsx scripts/create-organization.ts",
    "admin:import": "tsx --require ./scripts/server-only-stub.cjs scripts/import.ts",
    "ops:verify-migrations": "tsx scripts/verify-migrations.ts",
    "ops:backup": "tsx scripts/backup.ts",
    "ops:restore-drill": "tsx scripts/restore-drill.ts",
    "ops:load-test": "tsx --require ./scripts/server-only-stub.cjs scripts/load-test.ts",
    "ops:scan-secrets": "tsx scripts/scan-secrets.ts",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
