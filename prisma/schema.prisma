// Distributor OS — Phase 1 schema (foundation only).
//
// Two rules hold across every model in this file and every model added later:
//
//   1. Every business-owned table carries `organizationId`. A table without it is a tenancy
//      hole, and `tests/tenancy/schema-coverage.test.ts` fails the build if one appears.
//   2. Every money column is `BigInt` minor units (santim for ETB) alongside an explicit
//      currency. There is no Decimal and no Float anywhere in the money path.
//
// Phase 2 adds inquiries and their item proposals at the end of this file. Phases 3-7 add:
// quotations, approvals, follow-ups, orders, payments, warehouse tasks and deliveries.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  // The application connects as a NOSUPERUSER role, so the RLS policies in the migrations
  // actually apply to it. Superusers bypass RLS unconditionally.
  url       = env("DATABASE_URL")
  // Migrations connect as the owner, which is allowed to create and alter tables.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  OWNER_ADMIN
  SALES_MANAGER
  SALESPERSON
  FINANCE
  WAREHOUSE
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  /// ISO-4217. ETB for the first market; present from day one so multi-currency is a
  /// migration rather than a rewrite.
  currency      String   @default("ETB") @db.VarChar(3)
  timezone      String   @default("Africa/Addis_Ababa")
  defaultLocale String   @default("en") @map("default_locale")
  /// VAT in basis points (1500 = 15%). Integer, because a rate that multiplies money must
  /// itself be exact.
  vatRateBp     Int      @default(1500) @map("vat_rate_bp")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings               OrganizationSettings?
  memberships            Membership[]
  sessions               Session[]
  customers              Customer[]
  products               Product[]
  productAliases         ProductAlias[]
  inventoryMovements     InventoryMovement[]
  auditEvents            AuditEvent[]
  numberSequences        NumberSequence[]
  inquiries              Inquiry[]
  inquiryItems           InquiryItemProposal[]
  aiInteractions         AiInteraction[]
  quotations             Quotation[]
  quotationItems         QuotationItem[]
  quotationApprovals     QuotationApproval[]
  quotationFollowUps     QuotationFollowUp[]
  salesOrders            SalesOrder[]
  salesOrderItems        SalesOrderItem[]
  stockReservations      StockReservation[]
  payments               Payment[]
  paymentEvidence        PaymentEvidenceFile[]
  warehouseTasks         WarehouseTask[]
  warehouseTaskItems     WarehouseTaskItem[]
  deliveries             Delivery[]
  inventoryDiscrepancies InventoryDiscrepancy[]
  returns                Return[]
  returnItems            ReturnItem[]
  importJobs             ImportJob[]

  @@map("organizations")
}

model OrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  /// Discount authority in basis points. A salesperson may approve their own quotation up to
  /// this discount; beyond it, a sales manager must approve. Phase 3 consumes these.
  salespersonDiscountLimitBp  Int @default(300) @map("salesperson_discount_limit_bp")
  salesManagerDiscountLimitBp Int @default(1000) @map("sales_manager_discount_limit_bp")

  /// A quotation priced below this fraction of the list price always needs manager approval,
  /// regardless of how the reduction was expressed.
  minimumPriceFloorBp Int @default(9000) @map("minimum_price_floor_bp")

  defaultPaymentTermsDays Int @default(30) @map("default_payment_terms_days")
  quoteValidityDays       Int @default(7) @map("quote_validity_days")
  followUpIntervalDays    Int @default(2) @map("follow_up_interval_days")

  /// How many times one quotation may be chased before the sequence stops offering another.
  ///
  /// A cap rather than an open-ended loop: a system that keeps generating follow-ups forever
  /// trains salespeople to ignore the queue, which costs more than the chases are worth. Four
  /// is a starting point, not a finding.
  maxFollowUpCount Int @default(4) @map("max_follow_up_count")

  /// Whether a delivery charge attracts VAT at the organization's rate.
  ///
  /// A setting rather than a constant because the brief is explicit that the tax treatment of
  /// delivery must be stated rather than assumed. The default is true: transport supplied along
  /// with goods is normally taxable, and an organization that believes otherwise should have to
  /// say so on a settings screen rather than discover it in a total.
  deliveryFeeTaxable Boolean @default(true) @map("delivery_fee_taxable")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// A person. Users are global; their authority is always organization-scoped through a
/// Membership, so nothing here grants access to anything on its own.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  locale       String    @default("en")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    Membership[]
  sessions       Session[]
  /// Warehouse tasks this person is picking. Assignment is optional and advisory.
  warehouseTasks WarehouseTask[] @relation("WarehouseTaskAssignee")

  @@map("users")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

/// A session is bound to one organization as well as one user. Switching organization issues a
/// new session rather than mutating this one, so a stolen cookie can never widen its own scope.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Only the hash is stored. The token itself is returned once, to the cookie.
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

enum CreditStatus {
  CASH_ONLY
  CREDIT_ALLOWED
  SUSPENDED
}

model Customer {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  companyName       String       @map("company_name")
  contactName       String?      @map("contact_name")
  phone             String?
  email             String?
  preferredLanguage String       @default("en") @map("preferred_language")
  address           String?
  creditStatus      CreditStatus @default(CASH_ONLY) @map("credit_status")
  /// Minor units of the organization's currency. Meaningless unless creditStatus allows credit.
  creditLimitMinor  BigInt       @default(0) @map("credit_limit_minor")
  paymentTermsDays  Int          @default(0) @map("payment_terms_days")
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiries    Inquiry[]
  quotations   Quotation[]
  salesOrders  SalesOrder[]
  payments     Payment[]

  @@index([organizationId])
  @@index([organizationId, companyName])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  sku               String
  name              String
  category          String?
  /// Display unit: bag, piece, quintal, m3. Quantities are integers in this unit.
  unit              String
  /// Minor units of the organization's currency.
  sellingPriceMinor BigInt  @map("selling_price_minor")
  /// Basis points (1500 = 15%). Per product, because not everything is taxed alike.
  taxRateBp         Int     @default(1500) @map("tax_rate_bp")

  availableStock   Int     @default(0) @map("available_stock")
  /// Held against confirmed sales orders. Phase 4 writes this; nothing reserves at quotation
  /// time — see architecture-baseline.md 7.3.
  reservedStock    Int     @default(0) @map("reserved_stock")
  reorderThreshold Int     @default(0) @map("reorder_threshold")
  active           Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aliases                ProductAlias[]
  inventoryMovements     InventoryMovement[]
  matchedInquiryItems    InquiryItemProposal[]  @relation("MatchedProduct")
  proposedInquiryItems   InquiryItemProposal[]  @relation("ProposedProduct")
  quotationItems         QuotationItem[]
  salesOrderItems        SalesOrderItem[]
  stockReservations      StockReservation[]
  warehouseTaskItems     WarehouseTaskItem[]
  inventoryDiscrepancies InventoryDiscrepancy[]
  returnItems            ReturnItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, active])
  @@map("products")
}

enum AliasSource {
  SEED
  MANUAL
  LEARNED
}

/// Customers do not write product names consistently: "12mm", "12 mm steel", "12 fer" and
/// "rebar 12" all mean Rebar 12mm. A table rather than an array column, because this is
/// searched by trigram similarity in Phase 2 and audited when a salesperson adds one.
model ProductAlias {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  /// As written by a human.
  alias           String
  /// Lowercased, punctuation-stripped, whitespace-collapsed. What matching compares against.
  normalizedAlias String      @map("normalized_alias")
  source          AliasSource @default(MANUAL)
  createdById     String?     @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedAlias])
  @@index([organizationId])
  @@index([productId])
  @@map("product_aliases")
}

/// Every movement of stock, with a reason. Kept complete from Phase 1 because reorder
/// recommendations and demand forecasting later depend on an unbroken history — and because
/// "who changed the cement count" is a question distributors actually ask.
/// Why physical stock changed, and on whose authority.
///
/// This *is* Phase 1's `StockAdjustment`, renamed and widened rather than replaced. Phase 1 gave
/// it the right shape — product, signed delta, resulting quantity, reason, actor, timestamp —
/// and the only thing wrong with it was its scope: manual corrections were recorded here while
/// fulfilment consumption was recorded only in the audit log, so no single place could answer
/// "why did Rebar 12mm decrease by 40". Phase 7 makes every physical stock change land here,
/// with the event that caused it attached.
///
/// Two competing stock-mutation paths would be worse than none, so the Phase 1 rows carry
/// forward as MANUAL_ADJUSTMENT rather than being orphaned beside a new table.
///
/// Deliberately not an accounting ledger and deliberately not event sourcing: `available_stock`
/// on the product stays the authority, and this is the history that explains it.
model InventoryMovement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid

  movementType InventoryMovementType @default(MANUAL_ADJUSTMENT) @map("movement_type")

  /// Signed: positive is a receipt, negative is a removal. Never zero — a movement that moved
  /// nothing is noise in the one history a stock dispute is settled from.
  delta      Int
  stockAfter Int    @map("stock_after")
  reason     String

  /// What caused it. All nullable, because a manual count correction relates to none of them.
  relatedOrderId       String? @map("related_order_id") @db.Uuid
  relatedReservationId String? @map("related_reservation_id") @db.Uuid
  relatedDiscrepancyId String? @map("related_discrepancy_id") @db.Uuid
  relatedReturnId      String? @map("related_return_id") @db.Uuid

  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, productId, createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

enum ActorType {
  USER
  SYSTEM
  AI
}

/// Append-only. Written inside the same transaction as the mutation it records, so a mutation
/// cannot commit without its audit row. `sequence` is allocated per organization under an
/// advisory lock, giving a gapless per-tenant ordering that a timestamp cannot promise.
model AuditEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sequence       BigInt
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  /// Dotted verb, e.g. "customer.created", "product.stock_adjusted".
  action         String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  oldState       Json?     @map("old_state")
  newState       Json?     @map("new_state")
  /// Where the change came from: "web", "seed", "api".
  source         String
  approvalStatus String?   @map("approval_status")
  aiInvolved     Boolean   @default(false) @map("ai_involved")
  /// Present only when the actor was AI and the action carried a computed confidence.
  confidence     Decimal?  @db.Decimal(5, 4)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sequence])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

enum SequenceKind {
  QUOTATION
  ORDER
  WAREHOUSE_TASK
  DELIVERY
  RETURN
  DISCREPANCY
}

/// Q-000001 and SO-000001. Allocated under a row lock so two salespeople clicking at the same
/// moment cannot receive the same number.
model NumberSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  kind           SequenceKind
  nextValue      BigInt       @default(1) @map("next_value")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind])
  @@map("number_sequences")
}

// ---------------------------------------------------------------------------
// Phase 2 — Inquiries
//
// An inquiry is what a customer actually sent, plus the system's interpretation of it. The two
// are kept apart on purpose: `rawMessage` is evidence and never changes, while the proposals
// below are a reading of it that a salesperson is expected to correct.
// ---------------------------------------------------------------------------

enum InquiryChannel {
  MANUAL
  WHATSAPP
  TELEGRAM
  EMAIL
  SMS
  PHONE_NOTE
}

enum InquiryStatus {
  RECEIVED
  PARSING
  NEEDS_REVIEW
  READY_FOR_QUOTE
  PARSE_FAILED
  CANCELLED
}

/// What the customer appears to want. Only REQUEST_QUOTATION can reach ready_for_quote.
enum InquiryIntent {
  REQUEST_QUOTATION
  STOCK_ENQUIRY
  ORDER_FOLLOW_UP
  PAYMENT_QUERY
  DELIVERY_QUERY
  OTHER
  UNKNOWN
}

model Inquiry {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  customerId     String?        @map("customer_id") @db.Uuid
  channel        InquiryChannel @default(MANUAL)

  /// Exactly what the customer sent. Untrusted input, and evidence: never rewritten.
  rawMessage         String        @map("raw_message")
  /// Whitespace-collapsed form used for display and fingerprinting. Not a translation.
  normalizedText     String        @map("normalized_text")
  /// BCP-47-ish tag as detected by the parser. Advisory only; nothing is gated on it.
  detectedLanguage   String?       @map("detected_language")
  intent             InquiryIntent @default(UNKNOWN)
  /// Free text the parser found for a delivery destination. Never geocoded in this phase.
  destinationText    String?       @map("destination_text")
  /// A customer name the parser read out of the text, when no customer was selected.
  parsedCustomerName String?       @map("parsed_customer_name")

  status         InquiryStatus @default(RECEIVED)
  assignedUserId String?       @map("assigned_user_id") @db.Uuid
  createdById    String?       @map("created_by_id") @db.Uuid

  /// Why the last parse attempt failed, when it did. Cleared on a successful re-parse.
  parseError String?   @map("parse_error")
  parsedAt   DateTime? @map("parsed_at") @db.Timestamptz(6)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  readyAt    DateTime? @map("ready_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          InquiryItemProposal[]
  aiInteractions AiInteraction[]
  quotations     Quotation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("inquiries")
}

/// How a product was arrived at. Drives both the confidence band and the match-distribution
/// metric, and is written by deterministic code only.
enum MatchMethod {
  /// Normalised request equals the normalised canonical product name.
  CANONICAL
  /// Normalised request equals an approved alias.
  ALIAS
  /// Explainable string similarity. Never reaches the strong-suggestion band.
  FUZZY
  /// Evidence too weak to name a product.
  UNRESOLVED
  /// A person chose the product; the machine's opinion is retained in the proposal columns.
  HUMAN
}

enum ItemReviewStatus {
  SUGGESTED
  CONFIRMED
  CORRECTED
  UNRESOLVED
  REJECTED
}

/// One requested line, as read from the customer's text.
///
/// The machine's proposal and the human's decision are stored side by side rather than one
/// overwriting the other: "what did the parser suggest, and what did the salesperson do about
/// it" is the question that tells you whether the parser is worth keeping.
model InquiryItemProposal {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  inquiryId      String @map("inquiry_id") @db.Uuid
  /// Order the items appeared in the message, so the review screen matches the message.
  position       Int

  /// The words the customer used. Never rewritten.
  rawName           String  @map("raw_name")
  requestedQuantity Int     @map("requested_quantity")
  /// Normalised unit token, or null when the customer did not give one.
  requestedUnit     String? @map("requested_unit")

  /// --- the machine's proposal, frozen at parse time ---
  proposedProductId  String?     @map("proposed_product_id") @db.Uuid
  proposedConfidence Decimal?    @map("proposed_confidence") @db.Decimal(5, 4)
  matchMethod        MatchMethod @default(UNRESOLVED) @map("match_method")
  /// Human-readable explanation of how the score was reached. Shown in the UI verbatim.
  matchReason        String      @default("") @map("match_reason")
  /// Runners-up, so the reviewer can pick without searching. [{productId,name,sku,confidence}]
  candidates         Json?
  /// Set when two candidates were too close to separate. Forces review regardless of score.
  ambiguous          Boolean     @default(false)

  /// --- the human's decision ---
  matchedProductId String?          @map("matched_product_id") @db.Uuid
  reviewStatus     ItemReviewStatus @default(SUGGESTED) @map("review_status")
  reviewedById     String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiry         Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  matchedProduct  Product?     @relation("MatchedProduct", fields: [matchedProductId], references: [id], onDelete: SetNull)
  proposedProduct Product?     @relation("ProposedProduct", fields: [proposedProductId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([inquiryId])
  @@map("inquiry_item_proposals")
}

/// Metadata about one AI call. Deliberately holds no payload.
///
/// The customer's text is already stored once, on the inquiry; copying it here would duplicate
/// personal data into a table nobody prunes. What is kept is what makes a bad parse
/// diagnosable: who answered, which prompt asked, and whether the answer validated.
model AiInteraction {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  inquiryId      String? @map("inquiry_id") @db.Uuid

  purpose          String
  provider         String
  model            String
  promptVersion    String @map("prompt_version")
  /// SHA-256 of the input. Lets identical inputs be correlated without storing the text.
  inputFingerprint String @map("input_fingerprint")

  /// Did the response satisfy its Zod schema?
  valid     Boolean
  /// Short machine-readable failure code when it did not. Never a raw provider payload.
  errorCode String? @map("error_code")
  itemCount Int?    @map("item_count")
  latencyMs Int?    @map("latency_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiry      Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@map("ai_interactions")
}

// ---------------------------------------------------------------------------
// Phase 3 — Quotations
//
// A quotation is a commercial promise. Two rules follow from that and shape everything below:
//
//   1. It is *snapshotted*. Every price, name, unit and tax rate is copied onto the line at
//      draft time. A quotation the customer has seen must not change because someone edited
//      the catalogue afterwards.
//   2. Approval is *bound to figures*. An approval carries the hash of the exact commercial
//      payload it was given, so editing anything approval-sensitive afterwards withdraws it.
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  /// The customer said yes. Reserved for Phase 4, which converts it to a sales order; no
  /// Phase 3 action reaches this state.
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
  CANCELLED
}

enum PaymentType {
  CASH
  CREDIT
}

/// Who is allowed to approve a given quotation, decided deterministically from the figures.
enum ApprovalLevel {
  SALESPERSON
  SALES_MANAGER
  /// Nobody. The discount exceeds the manager limit or breaches the price floor, and the
  /// remedy is to change the quotation rather than to find a bigger signature.
  BLOCKED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model Quotation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Q-000001. Allocated server-side from number_sequences under a row lock.
  quotationNumber String  @map("quotation_number")
  /// The reviewed inquiry this was drafted from, when there was one.
  inquiryId       String? @map("inquiry_id") @db.Uuid
  customerId      String  @map("customer_id") @db.Uuid

  status   QuotationStatus @default(DRAFT)
  currency String          @db.VarChar(3)

  paymentType      PaymentType @default(CASH) @map("payment_type")
  /// 0 for cash. For credit, bounded by the customer's own agreed terms.
  paymentTermsDays Int         @default(0) @map("payment_terms_days")

  /// --- deterministic totals, all integer minor units ---
  subtotalMinor      BigInt @default(0) @map("subtotal_minor")
  discountTotalMinor BigInt @default(0) @map("discount_total_minor")
  deliveryFeeMinor   BigInt @default(0) @map("delivery_fee_minor")
  /// Tax on the delivery fee, kept separate so the document can show it and so a change in the
  /// taxable-delivery policy stays visible rather than buried inside taxTotal.
  deliveryTaxMinor   BigInt @default(0) @map("delivery_tax_minor")
  taxTotalMinor      BigInt @default(0) @map("tax_total_minor")
  grandTotalMinor    BigInt @default(0) @map("grand_total_minor")

  validityDate  DateTime @map("validity_date") @db.Date
  customerNotes String?  @map("customer_notes")
  internalNotes String?  @map("internal_notes")

  /// --- approval binding ---
  /// Recomputed from the persisted rows after every mutation.
  currentPayloadHash  String        @map("current_payload_hash")
  /// The payload that was actually approved. Approval is live only while the two agree.
  approvedPayloadHash String?       @map("approved_payload_hash")
  /// The level the rules engine required at the moment of the last recalculation.
  requiredLevel       ApprovalLevel @default(SALESPERSON) @map("required_level")

  createdById      String?           @map("created_by_id") @db.Uuid
  approvedById     String?           @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?         @map("approved_at") @db.Timestamptz(6)
  submittedAt      DateTime?         @map("submitted_at") @db.Timestamptz(6)
  sentById         String?           @map("sent_by_id") @db.Uuid
  sentAt           DateTime?         @map("sent_at") @db.Timestamptz(6)
  /// --- Phase 4: what the customer said ---
  ///
  /// This is a record that staff were told the customer accepted. It is not, and must not be
  /// presented as, an electronic signature — nothing here authenticates the customer.
  acceptedAt       DateTime?         @map("accepted_at") @db.Timestamptz(6)
  acceptedById     String?           @map("accepted_by_id") @db.Uuid
  acceptanceSource AcceptanceSource? @map("acceptance_source")
  acceptanceNote   String?           @map("acceptance_note")

  rejectedAt      DateTime?        @map("rejected_at") @db.Timestamptz(6)
  rejectedById    String?          @map("rejected_by_id") @db.Uuid
  rejectionReason RejectionReason? @map("rejection_reason")
  rejectionNote   String?          @map("rejection_note")
  expiredAt       DateTime?        @map("expired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  inquiry      Inquiry?            @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  items        QuotationItem[]
  approvals    QuotationApproval[]
  followUps    QuotationFollowUp[]
  salesOrders  SalesOrder[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("quotations")
}

/// One priced line, frozen at the moment it was drafted.
///
/// `productId` is kept for traceability — "which catalogue entry did this come from" is a real
/// question — but nothing on this row is ever read back through it. Every commercial fact the
/// customer was shown lives in a snapshot column, so the line survives a rename, a reprice or
/// the deletion of the product intact.
model QuotationItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  quotationId    String  @map("quotation_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  skuSnapshot         String @map("sku_snapshot")
  descriptionSnapshot String @map("description_snapshot")
  unitSnapshot        String @map("unit_snapshot")

  /// Whole units only. See docs/phase-3-quotations.md on why fractional quantities are refused.
  quantity Int

  /// The catalogue price at snapshot time, kept so a discount can be shown against something.
  listUnitPriceMinor   BigInt @map("list_unit_price_minor")
  /// The per-unit price the line is actually built from. Equal to the list price in Phase 3;
  /// the column exists so a future authorised override needs no migration.
  quotedUnitPriceMinor BigInt @map("quoted_unit_price_minor")
  discountBp           Int    @default(0) @map("discount_bp")
  taxRateBp            Int    @map("tax_rate_bp")

  /// --- derived, stored so the displayed figures and the stored figures cannot disagree ---
  lineSubtotalMinor  BigInt @map("line_subtotal_minor")
  lineDiscountMinor  BigInt @map("line_discount_minor")
  taxableAmountMinor BigInt @map("taxable_amount_minor")
  taxMinor           BigInt @map("tax_minor")
  lineTotalMinor     BigInt @map("line_total_minor")

  sortOrder Int @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([quotationId])
  @@map("quotation_items")
}

/// A durable record of who approved which exact version.
///
/// Its own table rather than something inferred from the audit log, because "who approved this
/// payload" must be answerable by a query with a deterministic answer — and must keep its
/// answer after a later edit invalidates the approval.
model QuotationApproval {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  quotationId    String @map("quotation_id") @db.Uuid

  approverId    String        @map("approver_id") @db.Uuid
  /// The approver's role at the moment of the decision, not looked up later.
  approverRole  Role          @map("approver_role")
  /// The level the rules engine required when the decision was made.
  requiredLevel ApprovalLevel @map("required_level")
  /// The exact payload this decision was given for.
  payloadHash   String        @map("payload_hash")

  decision ApprovalDecision
  reason   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([quotationId])
  @@map("quotation_approvals")
}

// ---------------------------------------------------------------------------
// Phase 4 — Follow-ups, sales orders and stock reservations
//
// Three ideas shape everything below:
//
//   1. A follow-up is a task with history, not a flag. "How many times did we chase this and
//      what did they say" is the question that makes the queue worth having.
//   2. An order copies the accepted quotation's snapshots exactly. The commercial agreement was
//      settled at acceptance; re-deriving anything from the live catalogue would change it.
//   3. Reservation rows are the source of truth for committed stock. `product.reserved_stock`
//      is a maintained aggregate, kept in the same transaction and asserted by an invariant
//      test, so it can never drift into an unexplained number.
// ---------------------------------------------------------------------------

enum FollowUpStatus {
  DUE
  COMPLETED
  SNOOZED
  CANCELLED
}

enum FollowUpOutcome {
  NO_RESPONSE
  CUSTOMER_CONSIDERING
  CUSTOMER_REQUESTED_CHANGE
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  OTHER
}

/// One chase of one quotation.
///
/// A row per attempt rather than a counter on the quotation, so the outcome distribution — how
/// often "no response" turns into "considering" turns into an order — is a query rather than a
/// thing nobody recorded.
model QuotationFollowUp {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  quotationId    String @map("quotation_id") @db.Uuid

  /// 1 for the first chase after sending, 2 for the next, and so on. Capped by
  /// OrganizationSettings.maxFollowUpCount so the sequence cannot run forever.
  sequence Int

  dueAt  DateTime       @map("due_at") @db.Timestamptz(6)
  status FollowUpStatus @default(DUE)

  assignedUserId String? @map("assigned_user_id") @db.Uuid

  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  completedById String?          @map("completed_by_id") @db.Uuid
  outcome       FollowUpOutcome?
  note          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status, dueAt])
  @@index([quotationId])
  @@map("quotation_follow_ups")
}

/// How staff learned the customer had accepted. Recorded, never inferred.
enum AcceptanceSource {
  PHONE
  MESSAGE
  EMAIL
  IN_PERSON
  OTHER
}

/// Why a quotation did not convert. Optional, and worth having: it is the raw material of the
/// only sales intelligence a distributor actually acts on.
enum RejectionReason {
  PRICE
  STOCK
  DELIVERY
  TIMING
  COMPETITOR
  CUSTOMER_CANCELLED
  OTHER
}

/// The order itself: OPEN until it is CANCELLED or (in a later phase) COMPLETED.
enum SalesOrderStatus {
  OPEN
  CANCELLED
  COMPLETED
}

/// Kept separate from the order status on purpose. Whether money has arrived and whether goods
/// may leave are different questions with different owners, and conflating them into one status
/// enum is how a cash order ends up released because someone needed a value for "ready".
enum OrderPaymentStatus {
  /// Cash terms: payment is owed now and nothing has been confirmed.
  UNPAID
  /// Some confirmed payment has arrived, but not the whole amount.
  ///
  /// Added in Phase 5, deliberately. A partly-settled cash order is neither UNPAID nor PAID,
  /// and collapsing it into either would mislead: UNPAID hides money that genuinely arrived,
  /// PAID would release goods that are not paid for. Phase 4's rule that a cash order *starts*
  /// UNPAID and NOT_READY is unchanged.
  PARTIALLY_PAID
  /// Credit terms: nothing is owed yet, and the due date is the order's payment terms.
  NOT_REQUIRED_YET
  PAID
}

enum OrderFulfillmentStatus {
  NOT_READY
  READY
  CANCELLED
}

model SalesOrder {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  orderNumber String @map("order_number")
  /// The accepted quotation this order embodies. One active order per quotation, enforced by a
  /// partial unique index in the migration rather than by application code alone.
  quotationId String @map("quotation_id") @db.Uuid
  customerId  String @map("customer_id") @db.Uuid

  status            SalesOrderStatus       @default(OPEN)
  paymentStatus     OrderPaymentStatus     @map("payment_status")
  fulfillmentStatus OrderFulfillmentStatus @default(NOT_READY) @map("fulfillment_status")

  currency         String      @db.VarChar(3)
  paymentType      PaymentType @map("payment_type")
  paymentTermsDays Int         @default(0) @map("payment_terms_days")
  /// When credit falls due. Null for cash orders. Derived at creation from the accepted terms.
  paymentDueDate   DateTime?   @map("payment_due_date") @db.Date

  /// Copied from the quotation, santim for santim. Never recomputed from the catalogue.
  subtotalMinor      BigInt @map("subtotal_minor")
  discountTotalMinor BigInt @map("discount_total_minor")
  deliveryFeeMinor   BigInt @map("delivery_fee_minor")
  deliveryTaxMinor   BigInt @map("delivery_tax_minor")
  taxTotalMinor      BigInt @map("tax_total_minor")
  grandTotalMinor    BigInt @map("grand_total_minor")

  deliveryRequired        Boolean @default(false) @map("delivery_required")
  /// The address as it stood when the order was raised. Editing the customer record later must
  /// not silently redirect goods already promised somewhere else.
  deliveryAddressSnapshot String? @map("delivery_address_snapshot")

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      String?   @map("cancelled_by_id") @db.Uuid
  cancellationReason String?   @map("cancellation_reason")

  /// Phase 6. Operational completion — goods reached the customer. Says nothing about money:
  /// a delivered 30-day-credit order is COMPLETED and still owes its balance.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// The collection path, for an order that needs no delivery. A lightweight pair of fields
  /// rather than a Delivery row that never leaves the yard — inventing a delivery for a
  /// customer who drove in would make the delivery queue lie about what is on the road.
  /// Phase 7. An operational problem the order is carrying. Nullable, and never a substitute
  /// for what the customer agreed to buy: the accepted quantities are untouched by any of it.
  operationalException     OrderOperationalException? @map("operational_exception")
  operationalExceptionNote String?                    @map("operational_exception_note")

  pickedUpAt   DateTime? @map("picked_up_at") @db.Timestamptz(6)
  pickedUpById String?   @map("picked_up_by_id") @db.Uuid
  pickupNote   String?   @map("pickup_note")

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation              Quotation              @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer               Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                  SalesOrderItem[]
  reservations           StockReservation[]
  payments               Payment[]
  warehouseTasks         WarehouseTask[]
  deliveries             Delivery[]
  inventoryDiscrepancies InventoryDiscrepancy[]
  returns                Return[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("sales_orders")
}

/// A line of the agreement, copied from the quotation line it came from.
model SalesOrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  salesOrderId   String  @map("sales_order_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  skuSnapshot         String @map("sku_snapshot")
  descriptionSnapshot String @map("description_snapshot")
  unitSnapshot        String @map("unit_snapshot")

  quantity Int

  listUnitPriceMinor   BigInt @map("list_unit_price_minor")
  quotedUnitPriceMinor BigInt @map("quoted_unit_price_minor")
  discountBp           Int    @map("discount_bp")
  taxRateBp            Int    @map("tax_rate_bp")

  lineSubtotalMinor  BigInt @map("line_subtotal_minor")
  lineDiscountMinor  BigInt @map("line_discount_minor")
  taxableAmountMinor BigInt @map("taxable_amount_minor")
  taxMinor           BigInt @map("tax_minor")
  lineTotalMinor     BigInt @map("line_total_minor")

  /// How much of this line is currently held against stock. Equals `quantity` while the order
  /// is open under the all-or-nothing policy, and zero once released.
  reservedQuantity Int @default(0) @map("reserved_quantity")

  sortOrder Int @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  reservations   StockReservation[]
  warehouseItems WarehouseTaskItem[]
  returnItems    ReturnItem[]

  @@index([organizationId])
  @@index([salesOrderId])
  @@map("sales_order_items")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  /// Reserved for the warehouse phase, when goods actually leave. Nothing reaches it yet.
  CONSUMED
}

/// The source of truth for committed stock.
///
/// `product.reserved_stock` is a maintained aggregate of the ACTIVE rows here, written in the
/// same transaction. Keeping the rows means a release can subtract exactly what a specific
/// order took, rather than decrementing a shared counter by a number somebody computed — which
/// is how aggregates drift and how "why does this product show 40 reserved with no open orders"
/// becomes unanswerable.
model StockReservation {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  salesOrderId     String @map("sales_order_id") @db.Uuid
  salesOrderItemId String @map("sales_order_item_id") @db.Uuid
  productId        String @map("product_id") @db.Uuid

  quantity Int
  status   ReservationStatus @default(ACTIVE)

  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder             @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem         @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  discrepancies  InventoryDiscrepancy[]

  @@index([organizationId])
  @@index([salesOrderId])
  @@index([organizationId, productId, status])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// Phase 5 — Payment evidence, confirmation and receivables
//
// The organising idea is that "money arrived" is a claim until a specific person says
// otherwise. Three separate things are modelled, and only the third is authoritative:
//
//   claimed     someone says a customer paid, and attaches evidence
//   extracted   software reads candidate figures off that evidence
//   confirmed   a Finance user checks both against the order and puts their name to it
//
// Nothing in this file lets the first two move an order's payment state.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  /// Evidence is in, nothing has looked at it yet.
  SUBMITTED
  /// Extraction ran (or failed) and a person must now decide.
  NEEDS_REVIEW
  /// A Finance user confirmed this exact payload. Immutable from here.
  CONFIRMED
  REJECTED
}

/// What the submitter claims the evidence represents. Not proof of settlement — no provider is
/// integrated, and none of these is verified against anything.
enum PaymentMethod {
  BANK_TRANSFER
  TELEBIRR
  MOBILE_MONEY
  CASH_DEPOSIT
  OTHER
}

enum ExtractionStatus {
  /// No extractor has run — the metadata was typed by a person.
  NOT_ATTEMPTED
  SUCCEEDED
  /// The extractor answered in a shape the contract refuses. Recoverable: a person types it.
  SCHEMA_INVALID
  FAILED
}

/// Uploaded evidence: a screenshot, a photograph of a slip, or a PDF.
///
/// Stored under an opaque id in a FileStore, never under a filename and never in a public
/// directory. `contentHash` is the identity that matters: a confirmation binds to the exact
/// bytes a Finance user reviewed, so swapping the file afterwards cannot inherit the approval.
model PaymentEvidenceFile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Opaque key in the FileStore. Not a path, not a filename, not guessable.
  storageKey       String  @map("storage_key")
  /// SHA-256 of the stored bytes, hex.
  contentHash      String  @map("content_hash")
  /// Detected from the bytes, not from what the browser claimed.
  mimeType         String  @map("mime_type")
  sizeBytes        Int     @map("size_bytes")
  /// Kept for display only. Never used to locate or identify the file.
  originalFilename String? @map("original_filename")

  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId])
  @@map("payment_evidence_files")
}

/// One claimed payment against one sales order.
///
/// Several are permitted per order from the outset. Ethiopian B2B customers split transfers,
/// and a schema that assumed one payment per order would need migrating the first time that
/// happened — which is exactly when a business least wants a migration.
model Payment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  salesOrderId   String @map("sales_order_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  status   PaymentStatus @default(SUBMITTED)
  currency String        @db.VarChar(3)

  /// What the submitter says was paid.
  amountClaimedMinor   BigInt  @map("amount_claimed_minor")
  /// What Finance actually confirmed. Null until confirmation; never edited afterwards.
  amountConfirmedMinor BigInt? @map("amount_confirmed_minor")

  method               PaymentMethod
  providerName         String?       @map("provider_name")
  /// Bank or wallet transaction reference, as read or typed. Uniqueness is enforced across
  /// CONFIRMED payments per organization and provider — see the migration.
  transactionReference String?       @map("transaction_reference")
  payerName            String?       @map("payer_name")
  paymentDate          DateTime?     @map("payment_date") @db.Date

  evidenceFileId   String?          @map("evidence_file_id") @db.Uuid
  extractionStatus ExtractionStatus @default(NOT_ATTEMPTED) @map("extraction_status")
  /// Short machine-readable reason an extraction failed. Never a raw provider payload.
  extractionError  String?          @map("extraction_error")

  /// The deterministic factors the matcher found, as [{code, detail}]. Shown verbatim to
  /// Finance rather than reduced to a single invented score.
  matchFactors Json? @map("match_factors")

  submittedById String   @map("submitted_by_id") @db.Uuid
  submittedAt   DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason")

  /// The hash of the exact payload Finance confirmed, including the evidence content hash.
  confirmationPayloadHash String? @map("confirmation_payload_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  evidenceFile PaymentEvidenceFile? @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([salesOrderId])
  @@index([organizationId, transactionReference])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Phase 6 — warehouse fulfilment and delivery
// ---------------------------------------------------------------------------

/// The warehouse side of an order, kept separate from both payment and delivery on purpose.
///
/// Three axes, three owners. Finance decides whether money arrived; the warehouse decides
/// whether goods were picked and handed over; the driver decides whether they reached the
/// customer. Collapsing any pair into one status is how a distributor ends up releasing goods
/// because someone needed a value for "done".
enum WarehouseTaskStatus {
  PENDING
  IN_PROGRESS
  /// Physically picked and assembled, still in warehouse custody. No inventory has moved.
  PREPARED
  /// Goods have left warehouse custody. This — and only this — consumes stock.
  COMPLETED
  CANCELLED
}

enum WarehouseTaskItemStatus {
  PENDING
  PREPARED
}

model WarehouseTask {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  taskNumber   String @map("task_number")
  salesOrderId String @map("sales_order_id") @db.Uuid

  status WarehouseTaskStatus @default(PENDING)

  /// Who is picking it. Optional: a small yard assigns work by talking to each other.
  assignedUserId String? @map("assigned_user_id") @db.Uuid

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  preparedAt  DateTime? @map("prepared_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason")

  notes String?

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder             SalesOrder             @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  assignedUser           User?                  @relation("WarehouseTaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  items                  WarehouseTaskItem[]
  deliveries             Delivery[]
  inventoryDiscrepancies InventoryDiscrepancy[]

  @@unique([organizationId, taskNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([salesOrderId])
  @@map("warehouse_tasks")
}

/// One row per order line the warehouse must pick.
///
/// Explicit rows rather than reading the order lines directly, because a refusal has to name a
/// product and two quantities — "reservation mismatch on Rebar 12mm: 80 required, 60 active" is
/// actionable and "this order cannot be completed" is not. They also carry the snapshots
/// forward one more time, so nothing the warehouse reads can be changed by editing the
/// catalogue.
model WarehouseTaskItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  warehouseTaskId  String  @map("warehouse_task_id") @db.Uuid
  salesOrderItemId String  @map("sales_order_item_id") @db.Uuid
  productId        String? @map("product_id") @db.Uuid

  skuSnapshot         String @map("sku_snapshot")
  descriptionSnapshot String @map("description_snapshot")
  unitSnapshot        String @map("unit_snapshot")

  quantityRequired Int @map("quantity_required")
  /// 0 or the full required quantity. Phase 6 has no partial fulfilment: a half-picked line is
  /// an unfinished task, never a partly-shipped order.
  quantityPrepared Int @default(0) @map("quantity_prepared")

  status WarehouseTaskItemStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseTask  WarehouseTask  @relation(fields: [warehouseTaskId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([warehouseTaskId])
  @@map("warehouse_task_items")
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  DISPATCHED
  DELIVERED
  /// Goods left the warehouse and did not reach the customer. Deliberately *not* a return:
  /// nothing here puts stock back, because the goods are still out there somewhere.
  FAILED
  CANCELLED
}

enum DeliveryFailureReason {
  CUSTOMER_UNAVAILABLE
  WRONG_ADDRESS
  VEHICLE_ISSUE
  CUSTOMER_REJECTED
  OTHER
}

/// A delivery run for one order.
///
/// Every customer-facing field is snapshotted at creation. A delivery record is history, and
/// history that rewrites itself when someone edits a customer's phone number is not history.
model Delivery {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliveryNumber  String @map("delivery_number")
  salesOrderId    String @map("sales_order_id") @db.Uuid
  warehouseTaskId String @map("warehouse_task_id") @db.Uuid

  status DeliveryStatus @default(PENDING)

  customerNameSnapshot    String  @map("customer_name_snapshot")
  customerPhoneSnapshot   String? @map("customer_phone_snapshot")
  destinationTextSnapshot String  @map("destination_text_snapshot")

  /// Plain operational fields, not a fleet. There are no driver accounts and no vehicle table:
  /// a pilot distributor has three drivers and knows their names.
  assignedDriverName  String?   @map("assigned_driver_name")
  assignedDriverPhone String?   @map("assigned_driver_phone")
  vehicleReference    String?   @map("vehicle_reference")
  assignedAt          DateTime? @map("assigned_at") @db.Timestamptz(6)

  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(6)
  failedAt     DateTime? @map("failed_at") @db.Timestamptz(6)

  failureReason DeliveryFailureReason? @map("failure_reason")
  failureNote   String?                @map("failure_note")

  /// Phase 7. How the failure was dealt with, recorded *beside* the failure rather than
  /// instead of it. FAILED stays FAILED; this says what happened next.
  failureResolution DeliveryFailureResolution? @map("failure_resolution")
  resolvedById      String?                    @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime?                  @map("resolved_at") @db.Timestamptz(6)

  /// The attempt this one replaces. A retry is a new delivery, not an edit of the old one, so
  /// "DL-000010 failed, DL-000011 retried it, delivered" stays answerable forever.
  retryOfDeliveryId String? @map("retry_of_delivery_id") @db.Uuid
  /// 1 for the first run, 2 for the first retry, and so on.
  attemptNumber     Int     @default(1) @map("attempt_number")
  /// What staff wrote down. Not proof of delivery — there is no signature and no photo.
  deliveryNote      String? @map("delivery_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouseTask WarehouseTask @relation(fields: [warehouseTaskId], references: [id], onDelete: Restrict)
  retryOf       Delivery?     @relation("DeliveryRetry", fields: [retryOfDeliveryId], references: [id], onDelete: SetNull)
  retries       Delivery[]    @relation("DeliveryRetry")
  returns       Return[]

  @@unique([organizationId, deliveryNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([salesOrderId])
  @@map("deliveries")
}

// ---------------------------------------------------------------------------
// Phase 7 — fulfilment exceptions and returns
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  /// A counted correction, made by a person who walked the shelf. Phase 1's original meaning.
  /// The count a distributor starts with, recorded once at onboarding.
  ///
  /// Its own type rather than a manual adjustment with a helpful reason string, because it is a
  /// different kind of fact: everything after it is a movement *from* a known baseline, and the
  /// baseline itself was never observed by this system. When somebody asks in eight months why
  /// cement stands where it does, the ledger has to be able to say "it started at 1,430" without
  /// that being indistinguishable from a correction somebody typed.
  OPENING_BALANCE
  MANUAL_ADJUSTMENT
  /// Goods leaving warehouse custody against an order. Phase 6's consumption.
  FULFILLMENT_CONSUMPTION
  /// A discrepancy reconciled to a verified physical count.
  DISCREPANCY_RECONCILIATION
  /// Returned goods inspected and put back on the sellable shelf.
  RETURN_RESTOCK
  OTHER
}

/// What kind of gap between the system and the yard.
enum DiscrepancyType {
  PHYSICAL_SHORTAGE
  PHYSICAL_OVERAGE
  DAMAGED_STOCK
  /// The reservation rows and the order requirement disagree, independent of the physical count.
  RESERVATION_MISMATCH
  OTHER
}

enum DiscrepancyStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CANCELLED
}

enum DiscrepancyResolution {
  /// Physical stock corrected to the verified count.
  STOCK_RECONCILED
  /// The recount agreed with the system; nothing moved.
  COUNT_CONFIRMED_NO_CHANGE
  /// Withdrawn — miscounted, wrong product, wrong bay.
  NO_ACTION_REQUIRED
}

/// A gap between what the system believes is in the yard and what somebody counted.
///
/// Narrow on purpose: this is not incident management. Reporting is one act and resolving is
/// another, held by different people, because whoever finds sixty bags where the system says a
/// hundred should not also be the person who decides whose order loses its stock.
model InventoryDiscrepancy {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  discrepancyNumber String @map("discrepancy_number")

  /// Where it was noticed. Both nullable: a stock count on a quiet afternoon belongs to no order.
  warehouseTaskId String? @map("warehouse_task_id") @db.Uuid
  salesOrderId    String? @map("sales_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  reservationId   String? @map("reservation_id") @db.Uuid

  discrepancyType DiscrepancyType   @map("discrepancy_type")
  status          DiscrepancyStatus @default(OPEN)

  /// Everything observed at the moment of reporting, kept verbatim.
  ///
  /// Snapshots rather than live reads, because the value of the record is that it says what the
  /// system claimed *at the time somebody disagreed with it*. Re-deriving these later would
  /// erase the disagreement, which is the only thing worth keeping.
  systemOnHandQuantity   Int  @map("system_on_hand_quantity")
  systemReservedQuantity Int  @map("system_reserved_quantity")
  expectedTaskQuantity   Int? @map("expected_task_quantity")
  physicalCountQuantity  Int  @map("physical_count_quantity")
  /// physicalCount − systemOnHand. Negative is a shortage.
  varianceQuantity       Int  @map("variance_quantity")

  reportNote String? @map("report_note")

  reportedById String?  @map("reported_by_id") @db.Uuid
  reportedAt   DateTime @default(now()) @map("reported_at") @db.Timestamptz(6)

  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)

  resolutionType DiscrepancyResolution? @map("resolution_type")
  resolutionNote String?                @map("resolution_note")
  resolvedById   String?                @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?              @map("resolved_at") @db.Timestamptz(6)

  /// Set when the verified count cannot support the reservations already committed.
  ///
  /// Reconciliation refuses to finalise while this stands, because persisting the count would
  /// leave available_stock below reserved_stock — a state the database rejects and, worse, a
  /// promise to a customer the yard cannot keep. Clearing it is a commercial decision about
  /// whose order gives way, and that is not the warehouse's to make.
  reservationShortfall Int? @map("reservation_shortfall")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseTask WarehouseTask?    @relation(fields: [warehouseTaskId], references: [id], onDelete: SetNull)
  salesOrder    SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  reservation   StockReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, discrepancyNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([warehouseTaskId])
  @@index([organizationId, productId, status])
  @@map("inventory_discrepancies")
}

enum ReturnStatus {
  /// Agreed to come back; nothing has arrived.
  EXPECTED
  /// Physically back in the yard, uninspected.
  RECEIVED
  /// Counted and sorted into restockable and damaged.
  INSPECTED
  /// Stock has moved. Terminal.
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DELIVERY_FAILED
  CUSTOMER_REJECTED
  WRONG_GOODS
  DAMAGED_IN_TRANSIT
  OTHER
}

enum ReturnDisposition {
  RESTOCK
  DAMAGED
  MISSING
  MIXED
}

/// Goods physically coming back, and nothing else.
///
/// Not a refund, not a credit note, not a cancellation. A return moves inventory and records
/// what arrived in what condition. What the customer is owed is a commercial question this
/// phase deliberately leaves open and visible rather than answering automatically.
model Return {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  returnNumber String @map("return_number")
  salesOrderId String @map("sales_order_id") @db.Uuid
  /// The delivery these goods went out on. Never rewritten — this record exists precisely so
  /// that the failed delivery does not have to be.
  deliveryId   String @map("delivery_id") @db.Uuid

  status       ReturnStatus @default(EXPECTED)
  returnReason ReturnReason @map("return_reason")
  note         String?

  receivedById String?   @map("received_by_id") @db.Uuid
  receivedAt   DateTime? @map("received_at") @db.Timestamptz(6)

  inspectedById String?   @map("inspected_by_id") @db.Uuid
  inspectedAt   DateTime? @map("inspected_at") @db.Timestamptz(6)

  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  items        ReturnItem[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([salesOrderId])
  @@index([deliveryId])
  @@map("returns")
}

/// One line of a return.
///
/// The arithmetic is pinned by a CHECK rather than by intention:
///
///     quantityReceived = quantityRestockable + quantityDamaged
///     quantityExpected = quantityReceived + quantityMissing
///
/// So nothing disappears. Eighty went out, seventy-six came back sellable, four came back
/// broken — and if only seventy-eight arrived at all, two are recorded as missing rather than
/// quietly dropped out of the sum.
model ReturnItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  returnId         String  @map("return_id") @db.Uuid
  salesOrderItemId String  @map("sales_order_item_id") @db.Uuid
  productId        String? @map("product_id") @db.Uuid

  skuSnapshot         String @map("sku_snapshot")
  descriptionSnapshot String @map("description_snapshot")
  unitSnapshot        String @map("unit_snapshot")

  /// What went out on the delivery. The ceiling for everything below it.
  quantityDispatched Int @map("quantity_dispatched")

  quantityExpected    Int @map("quantity_expected")
  quantityReceived    Int @default(0) @map("quantity_received")
  quantityRestockable Int @default(0) @map("quantity_restockable")
  quantityDamaged     Int @default(0) @map("quantity_damaged")
  /// Before inspection this holds the whole expected quantity: nothing has arrived, so all of
  /// it is outstanding. Inspection redistributes it, and the identity above stays true
  /// throughout rather than only at the end.
  quantityMissing     Int @default(0) @map("quantity_missing")

  disposition ReturnDisposition @default(RESTOCK)
  note        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  return         Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([returnId])
  @@map("return_items")
}

/// How a failed delivery was dealt with. Set on the failed delivery itself, never replacing
/// its FAILED status — the failure happened, and a resolution is a second fact about it.
enum DeliveryFailureResolution {
  RETRY_DELIVERY
  RETURNED_TO_WAREHOUSE
  LOST_OR_UNRECOVERABLE
}

/// An operational problem an order is carrying, kept off `status` deliberately.
///
/// A fourth SalesOrderStatus value would have to be ordered against OPEN, CANCELLED and
/// COMPLETED, and it does not belong in that sequence: an order with a stock shortfall is still
/// open, and an order whose goods were lost is neither finished nor cancelled. Keeping it in its
/// own nullable column means the completion rules and the commercial record both stay as they
/// were, and the exception can be cleared without rewriting either.
enum OrderOperationalException {
  /// Reservation was reduced below what the accepted order requires.
  STOCK_SHORTFALL
  /// A delivery failed and has not been resolved.
  DELIVERY_FAILED
  /// Goods left and will not come back. Money already taken stays taken.
  DELIVERY_LOST
  /// Goods came back to the yard. What the customer is owed is unresolved.
  GOODS_RETURNED
}

/// A file somebody imported, recorded so they cannot import it twice.
///
/// The reason this exists is narrow and specific: opening stock. Importing a customer list twice
/// produces visible duplicates that somebody notices and deletes. Importing an opening-stock
/// file twice silently doubles the yard, and nothing about the result looks wrong — every number
/// is plausible, the ledger is consistent, and the error is only discovered when a physical
/// count disagrees weeks later.
///
/// Keyed on a hash of the file's content, not its name: "stock.csv" and "stock (1).csv" are the
/// same file, and `opening-FINAL.csv` is a different one.
model ImportJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  kind        ImportKind
  /// SHA-256 of the whitespace-normalised file content.
  fingerprint String

  /// What the operator called the file. Display only, and never trusted for anything.
  filename String?

  rowCount     Int @map("row_count")
  createdCount Int @default(0) @map("created_count")
  updatedCount Int @default(0) @map("updated_count")

  importedById String?  @map("imported_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, fingerprint])
  @@index([organizationId])
  @@map("import_jobs")
}

enum ImportKind {
  CUSTOMERS
  PRODUCTS
  OPENING_STOCK
}
