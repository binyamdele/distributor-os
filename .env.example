# Copy to .env and fill in. Never commit .env.
#
# Postgres runs on 5434 to avoid colliding with the other Postgres containers already
# running on this machine (5433, 15432, 55444).
#
# Two URLs, deliberately different roles:
#
#   DATABASE_URL  connects as distributor_app, a NOSUPERUSER role. Row-Level Security only
#                 applies to non-superusers, so this is what makes the RLS policies real
#                 rather than decorative. The application always uses this one.
#
#   DIRECT_URL    connects as the owner, and is used only by `prisma migrate` to create and
#                 alter tables. The application never uses it.
DATABASE_URL="postgresql://distributor_app:distributor_app@localhost:5434/distributor_os?schema=public"
DIRECT_URL="postgresql://distributor:distributor@localhost:5434/distributor_os?schema=public"

# Separate database for the integration tests. `pnpm test` truncates it freely.
TEST_DATABASE_URL="postgresql://distributor_app:distributor_app@localhost:5434/distributor_os_test?schema=public"
TEST_DIRECT_URL="postgresql://distributor:distributor@localhost:5434/distributor_os_test?schema=public"

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# AI provider. "mock" is the default and needs no API key — the application is fully runnable
# and testable without one. Set to "anthropic" only when a key is actually present.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# Where uploaded files are written in development. S3-compatible storage comes later.
FILE_STORAGE_DIR="./storage"

